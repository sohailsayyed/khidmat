// Postgres-flavored twin of ../schema.prisma, used only for the Vercel
// deployment (see VERCEL-SETUP.md). Docker and local dev keep using the
// SQLite schema at ../schema.prisma — untouched by this file. Keep the
// models here in sync with ../schema.prisma when the data model changes.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: Supabase's pooled connection (port 6543, PgBouncer) — used
  // for normal app queries at runtime, where many concurrent serverless
  // function instances need to share a small number of real DB connections.
  url       = env("DATABASE_URL")
  // DIRECT_URL: Supabase's direct connection (port 5432, no pooler) — used
  // only by `prisma migrate deploy`. Migrations need a real session-level
  // Postgres connection to take an advisory lock; PgBouncer's transaction
  // pooling mode doesn't support that, so migrate deploy just hangs forever
  // against the pooled URL instead of failing cleanly.
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  VIEWER
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
}

// Singleton row (id always "main") holding editable site-wide content.
model SiteSettings {
  id              String   @id @default("main")
  siteName        String   @default("Khidmat")
  tagline         String   @default("Serving humanity, one act of kindness at a time")
  heroTitle       String   @default("Together We Can Change Lives")
  heroSubtitle    String   @default("Khidmat connects generous hearts with people who need help the most. Join us in our mission.")
  heroImageUrl    String   @default("/api/uploads/sample-hero.svg")
  logoUrl         String   @default("")
  aboutTitle      String   @default("About Khidmat")
  aboutText       String   @default("Khidmat is a community-driven charity dedicated to providing food, education, healthcare, and shelter to those in need. Every contribution, big or small, helps us reach more people.")
  aboutImageUrl   String   @default("/api/uploads/sample-about.svg")
  contactNumber   String   @default("+91 90000 00000")
  contactEmail    String   @default("contact@khidmat.org")
  contactAddress  String   @default("Pune, Maharashtra, India")
  qrImageUrl      String   @default("/api/uploads/placeholder-qr.png")
  donateNote      String   @default("Scan the QR code or call us to donate. Every contribution is deeply appreciated.")
  facebookUrl     String   @default("")
  instagramUrl    String   @default("")
  twitterUrl      String   @default("")
  whatsappNumber  String   @default("")
  updatedAt       DateTime @updatedAt
}

model Cause {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String   @default("/api/uploads/placeholder-cause.svg")
  raisedLabel String   @default("")
  goalLabel   String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  message   String
  imageUrl  String   @default("")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum DonationSource {
  WEBSITE
  MANUAL
}

enum DonationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Donation {
  id          String         @id @default(cuid())
  donorName   String
  donorPhone  String         @default("")
  donorEmail  String         @default("")
  amount      Float
  source      DonationSource
  status      DonationStatus @default(PENDING)
  method      String         @default("")
  note        String         @default("")
  createdBy   String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  purpose   String
  amount    Float
  note      String   @default("")
  spentAt   DateTime @default(now())
  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
