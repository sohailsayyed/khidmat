# Copy to .env for local dev, or pass these as environment variables when
# running the Docker image / docker-compose.

# Local dev: a file next to the project. In Docker: matches the /app/data
# volume mounted in docker-compose.yml.
DATABASE_URL="file:./dev.db"

# Used to seed the first admin account on first run. Change these.
ADMIN_EMAIL="admin@khidmat.org"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Khidmat Admin"

# Signs the admin session cookie. Use a long random string in production,
# e.g.: openssl rand -base64 32
SESSION_SECRET="dev-only-change-this-secret-please-1234567890"
