# Copy to .env.docker (git-ignored) before running docker compose. This is
# separate from .env (used by `npm run dev`) because the database path is
# different: local dev uses a file next to the project, Docker uses the
# mounted /app/data volume.

DATABASE_URL=file:/app/data/khidmat.db

# Used to seed the first admin account (npm run db:seed, run once after
# first startup). Change these before deploying.
ADMIN_EMAIL=admin@khidmat.org
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Khidmat Admin

# Signs the admin session cookie. Generate a real one with:
#   openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string
